# L'Arcade — the doorman under podman Quadlet (/etc/containers/systemd/arcade.container)
[Unit]
Description=L'Arcade — the doorman
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/tomblancdev/arcade:0.1.0
ContainerName=arcade
Network=host
Environment=ARCADE_LISTEN=:8080
Volume=/etc/arcade:/etc/arcade:ro,Z
Volume=/srv/arcade/data:/data:Z
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
