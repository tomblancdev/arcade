# Managed by ansible (tomblancdev.wolf) — the catalogue, projected onto the
# engine every time the engine starts. The engine keeps its own config and
# rewrites it itself; what may exist is {{ arcade_wolf_catalogue_file }}, and
# this is the projection of it (add, replace, remove — nothing else).
[Unit]
Description=wolf-catalogue — project the catalogue onto the seat engine
After=wolf.service
Requires=wolf.service
PartOf=wolf.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=WOLF_SOCKET_PATH={{ arcade_wolf_runtime }}/wolf.sock
ExecStart=/usr/local/sbin/wolf-catalogue {{ arcade_wolf_catalogue_file }}

[Install]
WantedBy=wolf.service
