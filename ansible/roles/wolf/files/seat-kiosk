#!/bin/bash
# seat-kiosk — a browser seat: one page, full screen, and the seat tells the
# page who it is.
#
# Mounted by a catalogue line over the image's own start script
# (/opt/gow/startup-app.sh — Wildlife's Firefox has no setting for which
# page to open). The engine hands every seat two things a hub page needs and
# nothing else prints: WOLF_SESSION_ID, the seat's own session (the page's
# whole identity: the panel reads it back from the engine and joins it to
# the drawer the device is pointed at), and WOLF_VIDEO_BUFFER_CAPS, the
# video buffer caps the engine computed at its start — a room opened from
# this seat is made with them, and a room made without them streams nothing
# (the same hole as an API-added tile). The caps hold spaces and
# parentheses, so they ride base64url.
#
# SEAT_KIOSK_URL names the page (a catalogue `env` line); SEAT_KIOSK_BROWSER
# the binary (default Firefox's). Runs under the compositor the seat was
# given. Under SWAY (the one that works: bare on the engine's compositor,
# Firefox's fullscreen request is not granted and the page sits in a
# window — seen 2026-08-28) the launcher writes the command into sway's
# config as an `exec` line that sway hands to `sh -c`, so the URL — it holds
# `&` — is passed single-quoted, or the shell backgrounds the browser at the
# ampersand and runs the rest as a command. Pair it with the sway
# fullscreen watcher (seat-sway-fullscreen), which ends the bar and keeps
# the browser's window fullscreen.
set -e
source /opt/gow/launch-comp.sh

url="${SEAT_KIOSK_URL:?SEAT_KIOSK_URL names the page this seat shows}"
caps=$(printf '%s' "${WOLF_VIDEO_BUFFER_CAPS:-}" | base64 -w0 | tr '+/' '-_' | tr -d '=')
sep='?'; case "$url" in *\?*) sep='&' ;; esac
full="${url}${sep}session=${WOLF_SESSION_ID}&caps=${caps}"

export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
if [ -n "$RUN_SWAY" ]; then
  launcher "${SEAT_KIOSK_BROWSER:-/usr/bin/firefox}" --kiosk --no-remote "'${full}'"
else
  launcher "${SEAT_KIOSK_BROWSER:-/usr/bin/firefox}" --kiosk --no-remote "${full}"
fi
