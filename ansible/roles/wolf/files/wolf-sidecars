#!/bin/bash
# wolf-sidecars — a container beside every seat, for what its image does not carry.
#
# The engine spawns one container per seat and routes its sound to the
# session's own sink by the HOSTNAME a stream reports; it also hands every
# seat the socket of its audio server (PULSE_SERVER) and the name of its sink
# (PULSE_SINK). So a second container wearing the seat's hostname, socket and
# sink is mixed into the seat's sound — whatever image the seat runs, and
# without that image knowing. This watcher starts such companions when a seat
# starts and removes them when the seat dies: a Spotify Connect device today
# (Le Juke — Spotify's own Web Playback SDK in a browser, music under the
# game, driven from the person's phone wherever it is); whatever else
# tomorrow is a line in the register.
#
# WHAT A SEAT IS — read from the container engine, never guessed: a container
# with a bind mount at /home/retro whose source lies under the seat store,
# <seats>/<drawer>/<app title>. The drawer and the app are that path; the uid
# and gid the seat runs as are its PUID/PGID; the session is WOLF_SESSION_ID;
# the hostname is the one the engine's router mapped (the engine sets none,
# so it is the container id's — which is why it is READ, per seat).
#
# WHO IS LINKED — asked of the panel, never kept here. A companion is a
# person's account beside their seat, and the person's grant lives WITH THE
# PERSON, at the identity gateway; the panel is its broker. Every `every`
# seconds this asks the panel which drawers hold a grant for each companion
# (`link.url`), remembers the answer, starts what is missing beside the
# seats that are open, and ends what is no longer linked. A companion asks
# the panel itself for an hour's token (its `token_url`, the drawer filled
# in). Nothing of a person's is ever on this disk.
#
# A COMPANION runs as the drawer's uid, with every capability dropped and no
# new privileges, no device, a memory ceiling, its own /dev/shm (a browser
# wants one), ONLY the audio socket lent (read-only: connect needs no write
# on the file — never the whole runtime dir, which also holds the engine's
# API socket, and that one authenticates nobody), and the seat's hostname.
# It is labelled with the seat container's id — the tie that ends it with
# the seat — and with its link, so an unlink can end it too.
#
# usage: wolf-sidecars <sidecars.json>    (a daemon: reconciles, then follows the engine's events)
#   {"seats": "/srv/seats", "state": "/srv/wolf",
#    "link": {"url": "http://192.0.2.20:8080/api/projects/appliance/links/sync", "every": 10},
#    "sidecars": [{"name": "spotify", "image": "ghcr.io/example/juke:1.0.0",
#                  "token_url": "http://192.0.2.20:8080/api/projects/appliance/links/spotify/token?drawer={drawer}",
#                  "memory": "512m", "shm": "1g", "env": {"JUKE_NAME": "Le Juke – {app}"}}]}
# {app} and {drawer} in an env value or the token_url are the seat's. Images
# are pulled by the converge, never here (--pull never): a tap never waits.
set -u
cfg="${1:?usage: wolf-sidecars <sidecars.json>}"
tag=wolf-sidecars
log() { echo "$tag: $*"; }
seats=$(jq -r .seats "$cfg"); state=$(jq -r '.state // ""' "$cfg")
link_url=$(jq -r '.link.url // ""' "$cfg"); link_every=$(jq -r '.link.every // 10' "$cfg")
LABEL=wolf.sidecar.seat            # a companion carries its seat's container id here
LABEL_LINK=wolf.sidecar.link       # ...and "<sidecar>:<drawer>", the link it runs on
linked_file=/run/$tag.linked.json  # the panel's last answer: {"<sidecar>": ["<drawer>", ...]}
mapfile -t sidecars < <(jq -c '.sidecars[]' "$cfg")
[ "${#sidecars[@]}" -gt 0 ] || { log "no sidecar declared — nothing to do"; exec sleep infinity; }
[ -f "$linked_file" ] || echo '{}' > "$linked_file"

is_linked() { # <sidecar> <drawer>: what the panel last said
  jq -e --arg s "$1" --arg d "$2" '(.[$s] // []) | index($d) != null' "$linked_file" >/dev/null 2>&1
}

# One inspect, one line: id, hostname, uid, gid, session, pulse server, pulse
# sink, drawer, app — or nothing at all when the container is not a seat.
read_seat() { # <container id or name>
  # the home's source is <root>/<drawer>/<app>, where <root> is the seat
  # store OR the engine's own root (the engine names its root; the store is
  # reached through a symlink under it — read live: /srv/wolf/salon/RetroDECK)
  podman inspect --type container "$1" 2>/dev/null | jq -r --arg seats "$seats" --arg state "$state" '
    .[0] as $c
    | ($c.Mounts // [] | map(select(.Destination == "/home/retro")) | .[0].Source // "") as $src
    | select($src != "")
    | ($src | split("/")) as $p
    | select(($p | length) >= 3)
    | ($p[:-2] | join("/")) as $root
    | select($root == $seats or ($state != "" and $root == $state))
    | ($c.Config.Env // [] | map(split("=") | {key: .[0], value: (.[1:] | join("="))}) | from_entries) as $e
    | [$c.Id, $c.Config.Hostname, ($e.PUID // ""), ($e.PGID // ""), ($e.WOLF_SESSION_ID // ""),
       ($e.PULSE_SERVER // ""), ($e.PULSE_SINK // ""), $p[-2], $p[-1]] | @tsv'
}

is_companion() { # <container id or name>: one of ours?
  [ -n "$(podman inspect --type container --format '{{ index .Config.Labels "'"$LABEL"'" }}' "$1" 2>/dev/null)" ]
}

ensure() { # <seat container id or name>: every declared companion the drawer is linked to, beside it
  local line; line=$(read_seat "$1"); [ -n "$line" ] || return 0
  local id host uid gid session server sink drawer app
  IFS=$'\t' read -r id host uid gid session server sink drawer app <<<"$line"
  [ -n "$session" ] && [ -n "$server" ] && [ -n "$uid" ] || { log "$drawer/$app ($1): a seat without session/audio/uid in its env — not a seat this watcher knows; skipped"; return 0; }
  local socket="${server#unix:}"
  [ -S "$socket" ] || { log "$drawer/$app: the seat's audio socket $socket is not here — no companion"; return 0; }
  local s name image memory shm turl cname
  for s in "${sidecars[@]}"; do
    name=$(jq -r .name <<<"$s"); image=$(jq -r .image <<<"$s")
    memory=$(jq -r '.memory // "512m"' <<<"$s"); shm=$(jq -r '.shm // "1g"' <<<"$s")
    turl=$(jq -r '.token_url // ""' <<<"$s")
    cname="${name}_${session}"
    podman container exists "$cname" 2>/dev/null && continue
    is_linked "$name" "$drawer" || continue     # not linked: nothing, quietly (the panel is the one that says)
    turl=${turl//\{drawer\}/$drawer}; turl=${turl//\{app\}/$app}
    local -a envs=()
    while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      v=${v//\{app\}/$app}; v=${v//\{drawer\}/$drawer}
      envs+=(-e "$k=$v")
    done < <(jq -r '(.env // {}) | to_entries[] | [.key, .value] | @tsv' <<<"$s")
    [ -n "$turl" ] && envs+=(-e "JUKE_TOKEN_URL=$turl")
    if podman run -d --rm --name "$cname" --hostname "$host" --label "$LABEL=$id" --label "$LABEL_LINK=$name:$drawer" \
         --user "$uid:$gid" --cap-drop all --security-opt no-new-privileges \
         --memory "$memory" --shm-size "$shm" --pull never --log-driver journald --log-opt "tag=$cname" \
         -e HOME=/tmp/home -e PULSE_SERVER="$server" -e PULSE_SINK="$sink" "${envs[@]}" \
         -v "$socket:$socket:ro" "$image" </dev/null >/dev/null 2>"/run/$tag.err"; then
      log "$drawer/$app: $cname started beside the seat (hostname $host, sink ${sink:-default}, as $uid)"
    else
      log "$drawer/$app: $cname FAILED to start — $(tr '\n' ' ' <"/run/$tag.err")"
    fi
  done
}

retire() { # <seat container id>: every companion tied to it
  local c cname
  for c in $(podman ps -a -q --filter "label=$LABEL=$1" 2>/dev/null); do
    cname=$(podman inspect --format '{{.Name}}' "$c" 2>/dev/null || echo "$c")
    if podman rm -f "$c" >/dev/null 2>&1; then
      log "companion $cname retired with its seat"
    else
      log "companion $cname: rm failed (already gone?)"
    fi
  done
}

unlink_running() { # <sidecar> <drawer>: the drawer's running companions of that link, ended
  local c
  for c in $(podman ps -q --filter "label=$LABEL_LINK=$1:$2" 2>/dev/null); do
    podman rm -f "$c" >/dev/null 2>&1 && log "$2: unlinked from $1 — its companion ended"
  done
}

reconcile() {
  local c seat
  for c in $(podman ps -a -q --filter "label=$LABEL" 2>/dev/null); do
    seat=$(podman inspect --format '{{ index .Config.Labels "'"$LABEL"'" }}' "$c" 2>/dev/null)
    if [ -z "$seat" ] || ! podman inspect --type container --format '{{.State.Running}}' "$seat" 2>/dev/null | grep -q true; then
      podman rm -f "$c" >/dev/null 2>&1 && log "orphan companion $c removed (its seat is gone)"
    fi
  done
  for c in $(podman ps -q 2>/dev/null); do
    is_companion "$c" && continue
    ensure "$c"
  done
}

# --- who is linked: the panel's answer, every few seconds -------------------
link_loop() {
  local resp before after s name d c
  while :; do
    if resp=$(curl -fsS -m 5 -H 'Content-Type: application/json' -X POST --data '{}' "$link_url" 2>/dev/null) \
       && after=$(jq -c '.linked // {}' <<<"$resp" 2>/dev/null); then
      before=$(cat "$linked_file")
      if [ "$after" != "$before" ]; then
        echo "$after" > "$linked_file"
        log "the panel says: $(jq -r 'to_entries | map("\(.key)=" + (.value | join(","))) | join(" ")' <<<"$after")"
        # a drawer no longer linked: its running companions of that link end
        for s in "${sidecars[@]}"; do
          name=$(jq -r .name <<<"$s")
          for d in $(jq -r --arg n "$name" --argjson a "$after" '((.[$n] // []) - ($a[$n] // []))[]' <<<"$before"); do unlink_running "$name" "$d"; done
        done
        # a drawer newly linked with a seat already open: its companion starts now
        for c in $(podman ps -q 2>/dev/null); do is_companion "$c" || ensure "$c"; done
      fi
    fi
    sleep "$link_every"
  done
}

log "watching — ${#sidecars[@]} sidecar(s) declared: $(jq -r '[.sidecars[].name] | join(", ")' "$cfg")"
if [ -n "$link_url" ]; then
  log "asking the panel who is linked every ${link_every}s ($link_url)"
  link_loop &
else
  log "no panel named (link.url) — nobody is linked, nothing will start"
fi
reconcile
# the engine's own feed, the one Wolf itself reads for its router: a seat's
# start brings its companions, a seat's end takes them away
podman events --format json --filter type=container --filter event=start --filter event=died --filter event=remove 2>/dev/null \
| while IFS= read -r ev; do
    status=$(jq -r '.Status // ""' <<<"$ev"); id=$(jq -r '.ID // ""' <<<"$ev"); name=$(jq -r '.Name // ""' <<<"$ev")
    [ -n "$id" ] || continue
    case "$status" in
      start)
        is_companion "$id" && continue
        ensure "$id"
        ;;
      died|remove)
        if [ "$status" = died ] && [[ "$name" =~ ^([A-Za-z0-9-]+)_[0-9]+$ ]] && jq -e --arg n "${BASH_REMATCH[1]}" '.sidecars[] | select(.name==$n)' "$cfg" >/dev/null; then
          log "companion $name ended on its own — no restart until the next seat"
          continue
        fi
        retire "$id"
        ;;
    esac
  done
log "the events feed ended — exiting (the unit restarts this)"
exit 1
