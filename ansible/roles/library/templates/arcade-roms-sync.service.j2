# Managed by ansible (tomblancdev.arcade.library)
[Unit]
Description=arcade-roms-sync — the ROM store copied from the server to the local NVMe (every wake)
After=network-online.target remote-fs.target
Wants=network-online.target remote-fs.target
# the server down = keep the last copy; never "sync" an empty mount point over it
ConditionPathIsMountPoint={{ arcade_library_source }}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rsync {{ arcade_library_rsync_options }} --chown={{ arcade_library_user }}:{{ arcade_library_user }} {{ arcade_library_source }}/ {{ arcade_library_cache }}/

[Install]
WantedBy=multi-user.target
