# Managed by ansible (tomblancdev.arcade.library)
[Unit]
Description=arcade-roms-sync — the ROM store copied from the server to the local NVMe (every wake)
After=network-online.target remote-fs.target {{ arcade_library_mount_unit.stdout }}
Wants=network-online.target remote-fs.target {{ arcade_library_mount_unit.stdout }}
# the server down = keep the last copy; never "sync" an empty mount point over it
ConditionPathIsMountPoint={{ arcade_library_source }}

[Service]
Type=oneshot
RemainAfterExit=yes
# systemd would launch rsync in SELinux's confined rsync_t, which may not read
# an NFS mount (nfs_t) — this is a local copy, not the rsync daemon. The shell
# is the entrypoint the unconfined service domain accepts (rsync itself is
# not), and that domain transitions no further.
SELinuxContext=system_u:system_r:unconfined_service_t:s0
ExecStart=/bin/sh -c 'exec /usr/bin/rsync {{ arcade_library_rsync_options }} --chown={{ arcade_library_user }}:{{ arcade_library_user }} {{ arcade_library_source }}/ {{ arcade_library_cache }}/'

[Install]
WantedBy=multi-user.target
